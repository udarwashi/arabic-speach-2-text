# Copy to .env and edit. Real environment variables override every line here.

# The password the page asks for. Empty (or absent) = no login page at all.
S2T_PASSWORD=

# Wrong guesses allowed before that client is locked out, and for how long.
S2T_MAX_ATTEMPTS=3
S2T_LOCKOUT_SECONDS=900

# How long a successful login stays valid (12 hours).
S2T_SESSION_SECONDS=43200
